 "investigations": [
  {
   "id": "austria-1844-1921",
   "intro": {
    "en": "Railways crossed the Alps, a walled capital opened up, and a revolution failed. Then an empire split in two and finally dissolved. By 1921 'Austria' meant a small republic whose borders were still being settled, partly by treaty and partly by vote. Sixteen sourced events and three longer processes trace that change, reaching well beyond present-day Austria."
   },
   "range": {
    "end": "1924-12-31",
    "start": "1844-01-01"
   },
   "chapters": [
    {
     "id": "ch-rails",
     "intro": {
      "en": "Rail reached Styria before the revolutions and crossed its first mountain range after them."
     },
     "title": {
      "en": "Iron across the Alps"
     }
    },
    {
     "id": "ch-1848",
     "intro": {
      "en": "In Vienna, 1848 moved from concessions in March to military defeat in October."
     },
     "title": {
      "en": "The year of revolution"
     }
    },
    {
     "id": "ch-ring",
     "intro": {
      "en": "Vienna's fortifications gave way by imperial order to a new representative boulevard."
     },
     "title": {
      "en": "A capital without walls"
     }
    },
    {
     "id": "ch-dual",
     "intro": {
      "en": "Defeat in 1866 was followed within a year by a new settlement with Hungary, and later by nationalist programmes inside the monarchy."
     },
     "title": {
      "en": "An empire divided"
     }
    },
    {
     "id": "ch-end",
     "intro": {
      "en": "From Sarajevo to the steps of the Vienna parliament in a little over four years."
     },
     "title": {
      "en": "War and dissolution"
     }
    },
    {
     "id": "ch-borders",
     "intro": {
      "en": "A treaty fixed the terms, and votes in Carinthia and Sopron helped settle where the state ended. In the same years, Salzburg launched a festival."
     },
     "title": {
      "en": "Drawing a small republic"
     }
    }
   ],
   "question": {
    "en": "How did Austria change between 1844 and 1921?"
   }
  }
 ],
