# Phase 1 web app. Optional override for the reference basemap style.
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Hosted PostGIS, development database only. Keep the real value in .env, which git ignores.
# Supabase: Connect > Session pooler. The direct connection is IPv6-only on most networks.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Free key from https://api.europeana.eu/en (needs a Europeana account).
EUROPEANA_API_KEY=

# Private key for the /admin review screen. Generate a long random value.
ADMIN_TOKEN=
